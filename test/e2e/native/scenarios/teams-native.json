{
  "$schema": "internal/native-provider-scenario-v1",
  "provider": "teams-native",
  "platform": "Microsoft Teams",
  "app_name": "Microsoft Teams",
  "description": "Scaffold flow for launching Teams native, joining via stored URL, and asserting start/end events.",
  "steps": [
    { "action": "launch_app", "args": { "app_name": "Microsoft Teams" } },
    { "action": "focus_window", "args": { "app_name": "Microsoft Teams" } },
    { "action": "click_text", "args": { "app_name": "Microsoft Teams", "text": "Join with an ID", "timeout_ms": 5000 }, "optional": true },
    { "action": "type_text", "args": { "text": "${E2E_TEAMS_NATIVE_URL}" } },
    { "action": "press_key", "args": { "key": "return" } },
    { "action": "maybe_fill_otp", "args": { "timeout_ms": 120000, "poll_ms": 2000, "submit_key": "return" }, "optional": true },
    { "action": "click_text", "args": { "app_name": "Microsoft Teams", "text": "Join now", "timeout_ms": 45000 } },
    { "action": "assert_event", "args": { "event": "meeting_started", "platform": "Microsoft Teams", "timeout_ms": 60000 } },
    { "action": "click_text", "args": { "app_name": "Microsoft Teams", "text": "Leave", "timeout_ms": 30000 } },
    { "action": "assert_event", "args": { "event": "meeting_ended", "platform": "Microsoft Teams", "timeout_ms": 60000 } }
  ]
}
